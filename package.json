{
  "name": "stringsearchonce",
  "version": "0.1.0",
  "description": "Embedded Unicode substring search over compressed, independently retrievable posting pages",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swittk/StringSearchOnce.git"
  },
  "keywords": ["substring", "search", "inverted-index", "postings", "compression", "unicode"],
  "engines": { "node": "^18.18.0 || >=20.5.0" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "bench": "npm run build && node bench/search.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "18.18.14",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  }
}
